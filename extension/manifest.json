{
  "manifest_version": 3,
  "name": "chrome2kodi",
  "version": "0.1.0",
  "description": "Right-click a picture, video, audio or link and send it to Kodi, with send2kodi.",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send this page to Kodi"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
