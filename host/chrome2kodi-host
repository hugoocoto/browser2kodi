#!/usr/bin/env python3
"""
chrome2kodi-host - the native messaging host of the chrome2kodi extension.

The browser starts it and writes it {"url": ..., "queue": false}; it runs
send2kodi on the URL and answers {"ok": bool, "message": str} once Kodi is
playing it, or has failed to. Messages are JSON, each preceded by its length
as a 32-bit integer in native byte order.

Pictures inlined in a page (data: URLs) are saved to ~/.cache/chrome2kodi
first, for send2kodi to serve them as files. They are removed after a day.
"""

import json
import mimetypes
import os
import shutil
import struct
import subprocess
import sys
import time
import urllib.request

SEND2KODI = ""  # filled in by install.sh; else looked up in PATH
CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
    "chrome2kodi")
KEEP = 24 * 3600  # seconds saved pictures are kept
TIMEOUT = 300     # send2kodi waits START_TIMEOUT (60s) for playback itself


def read_message():
    """The next message, or None once the browser has closed the pipe."""
    raw = sys.stdin.buffer.read(4)
    if len(raw) < 4:
        return None
    (n,) = struct.unpack("=I", raw)
    return json.loads(sys.stdin.buffer.read(n))


def write_message(msg):
    data = json.dumps(msg).encode()
    sys.stdout.buffer.write(struct.pack("=I", len(data)) + data)
    sys.stdout.buffer.flush()


def send2kodi():
    path = SEND2KODI or shutil.which("send2kodi") or shutil.which(
        "send2kodi", path=os.path.expanduser("~/.local/bin"))
    if not path or not os.access(path, os.X_OK):
        raise RuntimeError("send2kodi not found; run install.sh again, or "
                           "with --send2kodi PATH")
    return path


def save_data_url(url):
    """A data: URL as a file, named with an extension Kodi knows."""
    os.makedirs(CACHE, exist_ok=True)
    now = time.time()
    for name in os.listdir(CACHE):
        path = os.path.join(CACHE, name)
        if now - os.path.getmtime(path) > KEEP:
            os.remove(path)
    with urllib.request.urlopen(url) as r:
        ext = mimetypes.guess_extension(r.headers.get_content_type()) or ".jpg"
        path = os.path.join(CACHE, f"image-{time.time_ns()}{ext}")
        with open(path, "wb") as f:
            shutil.copyfileobj(r, f)
    return path


def handle(msg):
    url = msg.get("url", "")
    if url.startswith("data:"):
        url = save_data_url(url)
    elif not url.lower().startswith(("http://", "https://")):
        return {"ok": False, "message": f"not a web address: {url[:100]}"}
    # --bg: pictures and local files are served by send2kodi, which then has
    # to outlive this host, which the browser ends once it has the answer.
    cmd = [send2kodi(), "--bg"] + (["-q"] if msg.get("queue") else []) + ["--", url]
    r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True,
                       text=True, timeout=TIMEOUT)
    out = (r.stderr if r.returncode else r.stdout).strip()
    out = "\n".join(line.removeprefix("send2kodi: ") for line in out.splitlines())
    return {"ok": r.returncode == 0, "message": out}


def main():
    while (msg := read_message()) is not None:
        try:
            reply = handle(msg)
        except Exception as e:  # anything, rather than no answer at all
            reply = {"ok": False, "message": str(e)}
        write_message(reply)


if __name__ == "__main__":
    main()
